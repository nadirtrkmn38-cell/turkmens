<mxfile host="app.diagrams.net"><diagram name="ETS Kapsam Pusulası" id="ets-0"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="3450" background="#fbfbf8" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value="&lt;b&gt;Tesis değerlendirmesini başlat&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a9b2a6;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="270" width="320" height="60" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;Tesiste EK-1 listesindeki bir faaliyet yürütülüyor mu?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;m. 27/2 · EK-1&lt;/font&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#e9ece5;strokeColor=#a9b2a6;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="675" y="335" width="530" height="195" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;Ar-Ge tesisi, münhasıran biyokütle kullanan tesis veya askerî unsur mu?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;m. 2/2&lt;/font&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#e9ece5;strokeColor=#a9b2a6;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="675" y="543" width="530" height="195" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;Okul, üniversite, hastane, savunma sanayi veya gaz / ham petrol iletim-depolama tesisi mi?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;m. 5/2-3 · Geçici m. 6&lt;/font&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#e9ece5;strokeColor=#a9b2a6;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="655" y="754" width="570" height="205" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;Kurulu kapasiteye göre ihtiyatlı hesaplanan yıllık emisyon kaç ton CO₂e?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;m. 4 · m. 5/1&lt;/font&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#e9ece5;strokeColor=#a9b2a6;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="675" y="975" width="530" height="195" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;KAPSAM DIŞI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Hiçbir yükümlülük doğmaz. Tahsisat, izin, izleme ve raporlama yok.&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dcebdd;strokeColor=#2e6b3c;fontColor=#1c4426;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1310" y="387" width="420" height="90" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;YÖNETMELİK DIŞI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;İstisna yalnızca ilgili tesis veya tesis bölümü için geçerlidir.&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dcebdd;strokeColor=#2e6b3c;fontColor=#1c4426;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1310" y="595" width="420" height="90" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;ETS DIŞI — İRD YÜKÜMLÜSÜ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tahsisat almaz, teslim etmezsiniz. Kategoriniz yine de belirlenir: ceza kademesi ve personel şartı kategoriye bağlıdır.&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f8ebd3;strokeColor=#9a6208;fontColor=#5a3a05;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="440" y="1365" width="440" height="110" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;ETS KAPSAMINDA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;İzin + izleme, raporlama, doğrulama + her yıl emisyona denk tahsisat teslimi.&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1090" y="1365" width="440" height="110" as="geometry"/></mxCell><mxCell id="12" value="&lt;b&gt;İzleme planını onaylatın&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;İlk izlemeden en az 6 ay önce Başkanlığa sunulur (m. 28/3)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f8ebd3;strokeColor=#9a6208;fontColor=#5a3a05;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1517" width="420" height="86" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;Emisyonları izleyin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Emisyon = Faaliyet verisi × Emisyon faktörü × Oksidasyon faktörü&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f8ebd3;strokeColor=#9a6208;fontColor=#5a3a05;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1645" width="420" height="86" as="geometry"/></mxCell><mxCell id="14" value="&lt;b&gt;Akredite kuruluşa doğrulatın&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MEDAS ataması · ISO/IEC 17029 akreditasyonu (m. 30 · m. 33/2)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f8ebd3;strokeColor=#9a6208;fontColor=#5a3a05;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1773" width="420" height="86" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;30 Nisan&#x27;a kadar raporlayın&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CEZA RİSKİ · Bir önceki takvim yılının doğrulanmış emisyonu — gecikmede Kategori A için 627.450 ₺ (m. 29 · m. 35)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f8ebd3;strokeColor=#9a6208;fontColor=#5a3a05;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1901" width="420" height="86" as="geometry"/></mxCell><mxCell id="16" value="&lt;b&gt;Yetkili personeli atayın&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Kategori B: 1 kişi · Kategori C: 2 kişi (EK-3)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="1517" width="420" height="86" as="geometry"/></mxCell><mxCell id="17" value="&lt;b&gt;İzleme planı ve İzleme Metodolojisi Planını hazırlayın&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;İkisi de izin başvurusunun ekidir (EK-3 · EK-4)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="1645" width="420" height="86" as="geometry"/></mxCell><mxCell id="18" value="&lt;b&gt;Sera gazı emisyon izni başvurusu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;EK-3 ile başvuru · azami 60 gün · 5 yıl geçerli (m. 7-8)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="1773" width="420" height="86" as="geometry"/></mxCell><mxCell id="19" value="&lt;b&gt;Emisyonları izleyin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Alt tesis bazında: ürün, ölçülebilir ısı, yakıt, üretim süreci&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="1901" width="420" height="86" as="geometry"/></mxCell><mxCell id="20" value="&lt;b&gt;Akredite kuruluşa doğrulatın&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Doğrulanmamış rapor sunulamaz · 4734 sayılı Kanuna tabi işletmeler MEDAS dışıdır (m. 30)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="2029" width="420" height="86" as="geometry"/></mxCell><mxCell id="21" value="&lt;b&gt;30 Nisan — rapor + faaliyet seviyesi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CEZA RİSKİ · İkisi birlikte sunulur (m. 29 · m. 13/5)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="2157" width="420" height="86" as="geometry"/></mxCell><mxCell id="22" value="&lt;b&gt;Ulusal Tahsisat Planı yayımlanır&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DIŞ OLAY · Raporların son teslim tarihinden itibaren 60 gün içinde (m. 11/2)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e7eaef;strokeColor=#8892a1;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="2285" width="420" height="86" as="geometry"/></mxCell><mxCell id="23" value="&lt;b&gt;Ücretsiz tahsisat başvurusu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UTP + 30 gün · geç başvuruda bedel %50 artırımlı (m. 14)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="2413" width="420" height="86" as="geometry"/></mxCell><mxCell id="24" value="&lt;b&gt;Açığı kapatın&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Birincil piyasa (ihale) · İkincil piyasa · Karbon kredisiyle denkleştirme · Bankalama ve ödünç alma&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="2541" width="420" height="86" as="geometry"/></mxCell><mxCell id="25" value="&lt;b&gt;Tahsisatı teslim edin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CEZA RİSKİ · Kasım son iş günü · ek rezerv kullananlarda Aralık (m. 16)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="2669" width="420" height="86" as="geometry"/></mxCell><mxCell id="26" value="&lt;b&gt;Sürekli yükümlülükler — her iki profil için&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tüm veri ve bilgi kayıtlarını en az 10 yıl saklayın (m. 37) · Faaliyet, tesis niteliği, kategori veya izin sahibi değişikliklerini 30 gün içinde Başkanlığa bildirin (m. 9/1 · m. 34/4-5)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a9b2a6;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="435" y="2867" width="1100" height="90" as="geometry"/></mxCell><mxCell id="27" value="&lt;b&gt;EK-1 FAALİYETLERİ (ÖZET)&lt;/b&gt;&lt;br&gt;&lt;br&gt;ENERJİ&lt;br&gt;• Yakıtların yakılması — tesisteki TÜM yakma ünitelerinin toplam anma ısıl gücü ≥ 20 MW&lt;br&gt;• Petrol rafinasyonu — ≥ 20 MW&lt;br&gt;• Kok üretimi — eşik yok&lt;br&gt;METAL&lt;br&gt;• Cevher kavurma, sinterleme, peletleme&lt;br&gt;• Demir-çelik üretimi ve dökümü — &gt; 2,5 ton/saat&lt;br&gt;• Demirli metal işleme — ≥ 20 MW&lt;br&gt;• Birincil alüminyum ve alümina&lt;br&gt;• İkincil alüminyum, demir dışı metaller — ≥ 20 MW&lt;br&gt;MİNERAL&lt;br&gt;• Klinker — ≥ 500 t/gün (döner fırın)&lt;br&gt;• Kireç, dolomit, magnezit — ≥ 50 t/gün&lt;br&gt;• Cam — ≥ 20 t/gün · Seramik — ≥ 75 t/gün&lt;br&gt;• Mineral elyaf yalıtım — ≥ 20 t/gün&lt;br&gt;• Alçı taşı ürünleri — ≥ 20 MW&lt;br&gt;SELÜLOZ VE KÂĞIT&lt;br&gt;• Selüloz üretimi — eşik yok&lt;br&gt;• Kâğıt, mukavva, karton — ≥ 20 t/gün&lt;br&gt;KİMYA&lt;br&gt;• Karbon siyahı — ≥ 20 MW&lt;br&gt;• Nitrik asit, adipik asit, glioksal, amonyak&lt;br&gt;• Organik kimyasallar — ≥ 100 t/gün&lt;br&gt;• Hidrojen ve sentez gazı — ≥ 5 t/gün&lt;br&gt;• Soda külü ve sodyum bikarbonat&lt;br&gt;&amp;nbsp;&lt;br&gt;Tam liste 25 faaliyettir. Ayrıntı için EK-1&#x27;e bakınız." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3ed;strokeColor=#cdd3c8;fontColor=#16232b;strokeWidth=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="48" y="276" width="344" height="514" as="geometry"/></mxCell><mxCell id="28" value="&lt;b&gt;TOPLAM ANMA ISIL GÜCÜ NASIL HESAPLANIR?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tesisteki tüm yakma ünitelerinin anma ısıl güçleri TOPLANIR: kazan, brülör, türbin, ısıtıcı, ocak, insineratör, kalsinatör, döner fırın, fırın, kurutucu, motor, yakıt hücresi, yakma bacası, termal veya katalitik yakma sonrası ünitesi.&lt;br&gt;&amp;nbsp;&lt;br&gt;3 MW altındaki üniteler ve münhasıran biyokütle kullananlar bu toplama GİRMEZ.&lt;br&gt;Toplam 20 MW ve üzeriyse tesis EK-1 kapsamındadır." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3ed;strokeColor=#cdd3c8;fontColor=#16232b;strokeWidth=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="48" y="818" width="344" height="217" as="geometry"/></mxCell><mxCell id="29" value="&lt;b&gt;EN ÇOK KAÇIRILAN ÜÇ KURAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Aynı kategorideki faaliyetlerin kapasiteleri toplanarak eşiğe bakılır.&lt;br&gt;• Eşik kurulu kapasiteye bakar, fiilî üretime değil.&lt;br&gt;• EK-1&#x27;deki bir faaliyeti yürüten işletmenin aynı tesisteki diğer EK-1 faaliyetleri, kapasite gözetilmeksizin kapsama dâhil olur (m. 27/2)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3ed;strokeColor=#cdd3c8;fontColor=#16232b;strokeWidth=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="48" y="1063" width="344" height="170" as="geometry"/></mxCell><mxCell id="30" value="&lt;b&gt;İSTİSNALARIN SÜRESİ&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Kategori A — kalıcı olarak ETS dışı, İRD sürer&lt;br&gt;• Okul, üniversite, hastane, savunma sanayi — kalıcı istisna (m. 5/2-3)&lt;br&gt;• Gaz ve ham petrol iletimi-depolaması — yalnızca birinci uygulama dönemi sonuna kadar (Geçici m. 6)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3ed;strokeColor=#cdd3c8;fontColor=#16232b;strokeWidth=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="48" y="1261" width="344" height="155" as="geometry"/></mxCell><mxCell id="31" value="&lt;b&gt;İDARİ PARA CEZALARI (m. 35)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Doğrulanmış raporu süresinde sunmayanlara, tesis kategorisine göre:&lt;br&gt;&amp;nbsp;&lt;br&gt;• Kategori A — ≤ 50.000 t · 627.450 ₺&lt;br&gt;• Kategori B — 50.001–250.000 t · 1.254.900 ₺&lt;br&gt;• Kategori B — 250.001–500.000 t · 2.509.800 ₺&lt;br&gt;• Kategori C — 500.001–2.000.000 t · 4.392.150 ₺&lt;br&gt;• Kategori C — &gt; 2.000.000 t · 6.274.500 ₺&lt;br&gt;&amp;nbsp;&lt;br&gt;ETS kapsamındaki işletmelere bu tutarlar İKİ KAT uygulanır.&lt;br&gt;İzinsiz faaliyet ayrı bir ceza kalemidir: 1.254.900 – 12.549.000 ₺." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6f5;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="48" y="1444" width="344" height="280" as="geometry"/></mxCell><mxCell id="32" value="&lt;b&gt;DİKKAT&lt;/b&gt;&lt;br&gt;&lt;br&gt;İzin 5 yıl geçerli. Bitiminden en az 6 ay önce yenileme başvurusu zorunlu (m. 8).&lt;br&gt;&amp;nbsp;&lt;br&gt;İzinsiz faaliyetin cezası 1.254.900 – 12.549.000 ₺ (m. 35).&lt;br&gt;&amp;nbsp;&lt;br&gt;Geçiş: Kanun&#x27;un yürürlüğünden itibaren 3 yıl içinde izin alınmalıdır. Bu süre içinde bir kereye mahsus izinli sayılırsınız (Geçici m. 2)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6f5;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1605" y="1716" width="250" height="249" as="geometry"/></mxCell><mxCell id="33" value="&lt;b&gt;İKİ HESAP&lt;/b&gt;&lt;br&gt;&lt;br&gt;Emisyon = Faaliyet verisi × Emisyon faktörü × Oksidasyon faktörü (EK-6)&lt;br&gt;Biyokütlenin emisyon faktörü sıfır kabul edilir.&lt;br&gt;&amp;nbsp;&lt;br&gt;Ücretsiz tahsisat = Kıyas değeri × Ücretsiz tahsisat oranı × Sektörel faaliyet katsayısı × Faaliyet seviyesi (m. 13/7)&lt;br&gt;&amp;nbsp;&lt;br&gt;Açık = Doğrulanmış emisyon − Ücretsiz tahsisat&lt;br&gt;Bu fark her yıl piyasadan satın alınır. Azaltım yatırımlarının geri ödeme hesabına bu kalem de girer." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3ed;strokeColor=#cdd3c8;fontColor=#16232b;strokeWidth=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="48" y="1752" width="344" height="249" as="geometry"/></mxCell><mxCell id="34" value="&lt;b&gt;KAPSAMDAKİ SERA GAZLARI (EK-2)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Karbondioksit (CO₂)&lt;br&gt;• Metan (CH₄)&lt;br&gt;• Diazot oksit (N₂O)&lt;br&gt;• Hidroflorokarbonlar (HFC)&lt;br&gt;• Perflorokarbonlar (PFC)&lt;br&gt;• Kükürt heksaflorür (SF₆)&lt;br&gt;&amp;nbsp;&lt;br&gt;Kategori hesabında biyokütle kaynaklı CO₂ hariç, transfer edilen CO₂ dâhil tutulur (m. 4)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3ed;strokeColor=#cdd3c8;fontColor=#16232b;strokeWidth=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="48" y="2029" width="344" height="217" as="geometry"/></mxCell><mxCell id="35" value="&lt;b&gt;★ BİZİM DEVREYE GİRDİĞİMİZ YER&lt;/b&gt;&lt;br&gt;&lt;br&gt;Açık, her yıl piyasadan satın alınan bir maliyet kalemidir. Açığı küçültmek hem bu maliyeti hem de fiyat riskini azaltır.&lt;br&gt;&amp;nbsp;&lt;br&gt;NE YAPABİLİRİZ&lt;br&gt;• Enerji etüdü ile azaltım potansiyelinin tespiti&lt;br&gt;• Atık ısı geri kazanımı, buhar ve kondenstop iyileştirmesi, izolasyon&lt;br&gt;• Motor, sürücü (VSD) ve basınçlı hava sistemleri verimliliği&lt;br&gt;• Yakıt dönüşümü ve biyokütle — biyokütlenin emisyon faktörü sıfır kabul edilir (EK-6)&lt;br&gt;• Elektrifikasyon ile tesis içi yakma emisyonunun azaltılması&lt;br&gt;• Çatı GES ve öz tüketim, YEK-G ile yeşil elektrik tedariki&lt;br&gt;• ISO 50001 enerji yönetim sistemi kurulumu&lt;br&gt;• Sayaçlama ve veri altyapısı — İRD yükümlülüğüyle aynı altyapıyı besler&lt;br&gt;• Fizibilite: geri ödeme ve NBD hesabına tahsisat maliyetinin dâhil edilmesi&lt;br&gt;• VAP destekleriyle yatırım maliyetinin düşürülmesi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3efec;strokeColor=#0b5d58;fontColor=#11332f;strokeWidth=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1605" y="2434" width="250" height="498" as="geometry"/></mxCell><mxCell id="36" value="&lt;b&gt;BAŞVURULAR NEREYE YAPILIR, KİM NE YAPAR&lt;/b&gt;&lt;br&gt;&lt;br&gt;İKLİM DEĞİŞİKLİĞİ BAŞKANLIĞI&lt;br&gt;Sera gazı emisyon izni, izleme planı, İzleme Metodolojisi Planı, emisyon ve faaliyet seviyesi raporları ile ücretsiz tahsisat başvurusu buraya yapılır. Kıyas değerlerini ilan eder, ihale takvimini belirler. Tüm iş ve işlemler Başkanlıkça kurulan elektronik sistem üzerinden yürütülür (m. 7 · m. 14 · m. 28 · m. 29 · m. 34/6).&lt;br&gt;KARBON PİYASASI KURULU&lt;br&gt;Bakan başkanlığında toplanır. Ulusal Tahsisat Planını onaylar, ücretsiz tahsisat dağılımına ve birincil piyasada satışa sunulacak miktara karar verir, denkleştirme oranını ve fiyat aralıklarını belirler, pilot dönemi düzenler (m. 23).&lt;br&gt;EPDK&lt;br&gt;Tahsisatların kaydi ihracı, piyasaya sunulması ve İşlem Kayıt Sistemine ilişkin usul ve esasları belirler; ETS piyasasının işleyişini düzenler (m. 12/2 · m. 21/3 · m. 22/5).&lt;br&gt;PİYASA İŞLETMECİSİ&lt;br&gt;İşlem Kayıt Sistemini işletir, ihaleleri yürütür, ihale takvimini ilan eder. Tahsisat transferi ve teslimi bu sistem üzerinden gerçekleşir (m. 17/2 · m. 22/1).&lt;br&gt;MEDAS · TÜRKAK · DANIŞMA KURULU&lt;br&gt;MEDAS doğrulayıcı kuruluş atamasını yapar (m. 30/2). TÜRKAK doğrulayıcı kuruluşları ISO/IEC 17029&#x27;a göre akredite eder (m. 33/3). Danışma Kurulu TOBB başkanlığında toplanır ve istişari kararlar alır (m. 24)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3ed;strokeColor=#cdd3c8;fontColor=#16232b;strokeWidth=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="445" y="2990" width="630" height="358" as="geometry"/></mxCell><mxCell id="37" value="&lt;b&gt;FİYATI KİM, NEYE GÖRE BELİRLER&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tahsisatın sabit bir tarifesi yoktur; fiyat piyasada oluşur. Devlet fiyatı doğrudan koymaz, arzı ve sınırları belirler.&lt;br&gt;ARZ — ÜST SINIR&lt;br&gt;ETS üst sınırı emisyon yoğunluğu temelli belirlenir ve Ulusal Tahsisat Planı ile açıklanır. Birincil piyasada satışa sunulacak tahsisat miktarını Karbon Piyasası Kurulu tespit eder (m. 11 · m. 23/2).&lt;br&gt;BİRİNCİL PİYASA — İHALE&lt;br&gt;Tahsisatlar, Başkanlıkça belirlenen ihale takvimine göre ihaleyle satılır. Takvim, UTP yayımından sonraki 15 iş günü içinde Piyasa İşletmecisinin internet sitesinde ilan edilir (m. 17).&lt;br&gt;İKİNCİL PİYASA — ARZ VE TALEP&lt;br&gt;Sürekli ticaret yöntemiyle işletilir; fiyat alıcı ve satıcıların emirlerine göre oluşur (m. 18).&lt;br&gt;FİYAT ARALIĞI VE İSTİKRAR&lt;br&gt;Asgari ve azami tahsisat fiyatı aralıklarını belirlemeye Karbon Piyasası Kurulu yetkilidir; kararlar Başkanlıkça resmî internet sayfasında ilan edilir. Piyasa istikrar rezervi, dolaşımdaki tahsisat miktarı ve fiyatlar değerlendirilerek devreye alınır (m. 19 · m. 21/1).&lt;br&gt;EK REZERV FİYATI&lt;br&gt;Son 3 ayın birincil ve ikincil piyasa ağırlıklı ortalama fiyatlarından yüksek olanının %50 fazlası; azami fiyatı Başkanlık ve EPDK koordineli belirler (m. 16/6)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3ed;strokeColor=#cdd3c8;fontColor=#16232b;strokeWidth=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1105" y="2990" width="630" height="342" as="geometry"/></mxCell><mxCell id="38" value="&lt;b&gt;RENK ANAHTARI&lt;/b&gt;&lt;br&gt;&lt;br&gt;YEŞİL — yükümlülük yok, sistem hiç uygulanmaz&lt;br&gt;SARI — yalnızca izleme, raporlama ve doğrulama&lt;br&gt;KIRMIZI — tam ETS: izin, İRD ve tahsisat teslimi&lt;br&gt;GRİ — yardımcı bilgi, akışın parçası değil" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a9b2a6;fontColor=#16232b;strokeWidth=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1390" y="75" width="460" height="139" as="geometry"/></mxCell><mxCell id="39" value="&lt;b&gt;İşletmem ETS kapsamına giriyor mu?&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Türkiye Emisyon Ticaret Sistemi · Tesis değerlendirmesi — Dayanak: RG 27.08.2026 / 33353&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontColor=#16232b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="60" width="1200" height="120" as="geometry"/></mxCell><mxCell id="40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#6e7b76;strokeWidth=2;fontSize=11;fontColor=#4a5854;labelBackgroundColor=#fbfbf8;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="41" value="HAYIR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#6e7b76;strokeWidth=2;fontSize=11;fontColor=#4a5854;labelBackgroundColor=#fbfbf8;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="42" value="EVET" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#6e7b76;strokeWidth=2;fontSize=11;fontColor=#4a5854;labelBackgroundColor=#fbfbf8;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="43" value="EVET" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#6e7b76;strokeWidth=2;fontSize=11;fontColor=#4a5854;labelBackgroundColor=#fbfbf8;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="44" value="HAYIR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#6e7b76;strokeWidth=2;fontSize=11;fontColor=#4a5854;labelBackgroundColor=#fbfbf8;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="45" value="EVET — kategoriden bağımsız" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#6e7b76;strokeWidth=2;fontSize=11;fontColor=#4a5854;labelBackgroundColor=#fbfbf8;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="6" target="10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="506" y="856"/></Array><mxPoint as="offset" x="0" y="-12"/></mxGeometry></mxCell><mxCell id="46" value="HAYIR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#6e7b76;strokeWidth=2;fontSize=11;fontColor=#4a5854;labelBackgroundColor=#fbfbf