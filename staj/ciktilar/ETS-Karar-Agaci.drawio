<mxfile host="app.diagrams.net"><diagram name="ETS Kapsam Pusulası"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="3100" background="#fbfbf8" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value="&lt;b&gt;Tesis değerlendirmesini başlat&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a9b2a6;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="270" width="320" height="60" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;Tesiste EK-1 listesindeki bir faaliyet yürütülüyor mu?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;m. 27/2 · EK-1&lt;/font&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#e9ece5;strokeColor=#a9b2a6;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="357" width="440" height="150" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;Ar-Ge tesisi, münhasıran biyokütle kullanan tesis veya askerî unsur mu?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;m. 2/2&lt;/font&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#e9ece5;strokeColor=#a9b2a6;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="565" width="440" height="150" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;Okul, üniversite, hastane, savunma sanayi veya gaz / ham petrol iletim-depolama tesisi mi?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;m. 5/2-3 · Geçici m. 6&lt;/font&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#e9ece5;strokeColor=#a9b2a6;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="776" width="480" height="160" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;Kurulu kapasiteye göre ihtiyatlı hesaplanan yıllık emisyon kaç ton CO₂e?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;m. 4 · m. 5/1&lt;/font&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#e9ece5;strokeColor=#a9b2a6;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="997" width="440" height="150" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;KAPSAM DIŞI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Hiçbir yükümlülük doğmaz. Tahsisat, izin, izleme ve raporlama yok.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dcebdd;strokeColor=#2e6b3c;fontColor=#1c4426;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1310" y="387" width="420" height="90" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;YÖNETMELİK DIŞI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;İstisna yalnızca ilgili tesis veya tesis bölümü için geçerlidir.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dcebdd;strokeColor=#2e6b3c;fontColor=#1c4426;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1310" y="595" width="420" height="90" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;ETS DIŞI — İRD YÜKÜMLÜSÜ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Tahsisat almaz, teslim etmezsiniz. Kategoriniz yine de belirlenir: ceza kademesi ve personel şartı kategoriye bağlıdır.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8ebd3;strokeColor=#9a6208;fontColor=#5a3a05;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="1365" width="440" height="110" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;ETS KAPSAMINDA&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;İzin + izleme, raporlama, doğrulama + her yıl emisyona denk tahsisat teslimi.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1090" y="1365" width="440" height="110" as="geometry"/></mxCell><mxCell id="12" value="&lt;b&gt;İzleme planını onaylatın&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;İlk izlemeden en az 6 ay önce Başkanlığa sunulur (m. 28/3)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8ebd3;strokeColor=#9a6208;fontColor=#5a3a05;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="1517" width="420" height="86" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;Emisyonları izleyin&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Emisyon = Faaliyet verisi × Emisyon faktörü × Oksidasyon faktörü&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8ebd3;strokeColor=#9a6208;fontColor=#5a3a05;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="1645" width="420" height="86" as="geometry"/></mxCell><mxCell id="14" value="&lt;b&gt;Akredite kuruluşa doğrulatın&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;MEDAS ataması · ISO/IEC 17029 (m. 30)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8ebd3;strokeColor=#9a6208;fontColor=#5a3a05;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="1773" width="420" height="86" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;30 Nisan&#x27;a kadar raporlayın&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Bir önceki takvim yılının doğrulanmış emisyonu (m. 29)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8ebd3;strokeColor=#9a6208;fontColor=#5a3a05;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="1901" width="420" height="86" as="geometry"/></mxCell><mxCell id="16" value="&lt;b&gt;Yetkili personeli atayın&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Kategori B: 1 kişi · Kategori C: 2 kişi (EK-3)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="1517" width="420" height="86" as="geometry"/></mxCell><mxCell id="17" value="&lt;b&gt;İzleme planı ve İzleme Metodolojisi Planını hazırlayın&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;İkisi de izin başvurusunun ekidir (EK-3 · EK-4)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="1645" width="420" height="86" as="geometry"/></mxCell><mxCell id="18" value="&lt;b&gt;Sera gazı emisyon izni başvurusu&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;EK-3 ile başvuru · azami 60 gün · 5 yıl geçerli (m. 7-8)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="1773" width="420" height="86" as="geometry"/></mxCell><mxCell id="19" value="&lt;b&gt;Emisyonları izleyin&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Alt tesis bazında: ürün, ölçülebilir ısı, yakıt, üretim süreci&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="1901" width="420" height="86" as="geometry"/></mxCell><mxCell id="20" value="&lt;b&gt;Akredite kuruluşa doğrulatın&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Doğrulanmamış rapor sunulamaz (m. 30)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="2029" width="420" height="86" as="geometry"/></mxCell><mxCell id="21" value="&lt;b&gt;30 Nisan — rapor + faaliyet seviyesi&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;CEZA RİSKİ · İkisi birlikte sunulur (m. 29 · m. 13/5)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="2157" width="420" height="86" as="geometry"/></mxCell><mxCell id="22" value="&lt;b&gt;Ulusal Tahsisat Planı yayımlanır&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;DIŞ OLAY · Raporların son teslim tarihinden itibaren 60 gün içinde (m. 11/2)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e7eaef;strokeColor=#8892a1;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="2285" width="420" height="86" as="geometry"/></mxCell><mxCell id="23" value="&lt;b&gt;Ücretsiz tahsisat başvurusu&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;UTP + 30 gün · geç başvuruda bedel %50 artırımlı (m. 14)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="2413" width="420" height="86" as="geometry"/></mxCell><mxCell id="24" value="&lt;b&gt;Açığı kapatın&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Birincil piyasa (ihale) · İkincil piyasa · Karbon kredisiyle denkleştirme · Bankalama ve ödünç alma&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="2541" width="420" height="86" as="geometry"/></mxCell><mxCell id="25" value="&lt;b&gt;Tahsisatı teslim edin&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;CEZA RİSKİ · Kasım son iş günü · ek rezerv kullananlarda Aralık (m. 16)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f6e2df;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="2669" width="420" height="86" as="geometry"/></mxCell><mxCell id="26" value="&lt;b&gt;Kayıtları 10 yıl saklayın&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Tüm veriler ve bilgi kayıtları en az 10 yıl saklanır. Yukarıdaki adımların tamamı için geçerli sürekli bir yükümlülüktür (m. 37).&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a9b2a6;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="435" y="2872" width="1100" height="80" as="geometry"/></mxCell><mxCell id="27" value="&lt;b&gt;EK-1 FAALİYETLERİ (ÖZET)&lt;/b&gt;&lt;br&gt;ENERJİ&lt;br&gt;• Yakıtların yakılması — tesisteki TÜM yakma ünitelerinin toplam anma ısıl gücü ≥ 20 MW&lt;br&gt;• Petrol rafinasyonu — ≥ 20 MW&lt;br&gt;• Kok üretimi — eşik yok&lt;br&gt;METAL&lt;br&gt;• Cevher kavurma, sinterleme, peletleme&lt;br&gt;• Demir-çelik üretimi ve dökümü — &gt; 2,5 ton/saat&lt;br&gt;• Demirli metal işleme — ≥ 20 MW&lt;br&gt;• Birincil alüminyum ve alümina&lt;br&gt;• İkincil alüminyum, demir dışı metaller — ≥ 20 MW&lt;br&gt;MİNERAL&lt;br&gt;• Klinker — ≥ 500 t/gün (döner fırın)&lt;br&gt;• Kireç, dolomit, magnezit — ≥ 50 t/gün&lt;br&gt;• Cam — ≥ 20 t/gün · Seramik — ≥ 75 t/gün&lt;br&gt;• Mineral elyaf yalıtım — ≥ 20 t/gün&lt;br&gt;• Alçı taşı ürünleri — ≥ 20 MW&lt;br&gt;SELÜLOZ VE KÂĞIT&lt;br&gt;• Selüloz üretimi — eşik yok&lt;br&gt;• Kâğıt, mukavva, karton — ≥ 20 t/gün&lt;br&gt;KİMYA&lt;br&gt;• Karbon siyahı — ≥ 20 MW&lt;br&gt;• Nitrik asit, adipik asit, glioksal, amonyak&lt;br&gt;• Organik kimyasallar — ≥ 100 t/gün&lt;br&gt;• Hidrojen ve sentez gazı — ≥ 5 t/gün&lt;br&gt;• Soda külü ve sodyum bikarbonat&lt;br&gt;&amp;nbsp;&lt;br&gt;Tam liste 25 faaliyettir. Ayrıntı için EK-1&#x27;e bakınız." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3ed;strokeColor=#cdd3c8;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=left;verticalAlign=top;fontSize=10;spacing=8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="48" y="275" width="344" height="630" as="geometry"/></mxCell><mxCell id="28" value="&lt;b&gt;TOPLAM ANMA ISIL GÜCÜ NASIL HESAPLANIR?&lt;/b&gt;&lt;br&gt;Tesisteki tüm yakma ünitelerinin anma ısıl güçleri TOPLANIR: kazan, brülör, türbin, ısıtıcı, ocak, insineratör, kalsinatör, döner fırın, fırın, kurutucu, motor, yakıt hücresi, yakma bacası, termal veya katalitik yakma sonrası ünitesi.&lt;br&gt;&amp;nbsp;&lt;br&gt;3 MW altındaki üniteler ve münhasıran biyokütle kullananlar bu toplama GİRMEZ.&lt;br&gt;Toplam 20 MW ve üzeriyse tesis EK-1 kapsamındadır." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3ed;strokeColor=#cdd3c8;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=left;verticalAlign=top;fontSize=10;spacing=8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="48" y="927" width="344" height="270" as="geometry"/></mxCell><mxCell id="29" value="&lt;b&gt;EN ÇOK KAÇIRILAN ÜÇ KURAL&lt;/b&gt;&lt;br&gt;• Aynı kategorideki faaliyetlerin kapasiteleri toplanarak eşiğe bakılır.&lt;br&gt;• Eşik kurulu kapasiteye bakar, fiilî üretime değil.&lt;br&gt;• EK-1&#x27;deki bir faaliyeti yürüten işletmenin aynı tesisteki diğer EK-1 faaliyetleri, kapasite gözetilmeksizin kapsama dâhil olur (m. 27/2)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3ed;strokeColor=#cdd3c8;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=left;verticalAlign=top;fontSize=10;spacing=8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="48" y="1222" width="344" height="250" as="geometry"/></mxCell><mxCell id="30" value="&lt;b&gt;İSTİSNALARIN SÜRESİ&lt;/b&gt;&lt;br&gt;• Kategori A — kalıcı olarak ETS dışı, İRD sürer&lt;br&gt;• Okul, üniversite, hastane, savunma sanayi — kalıcı istisna (m. 5/2-3)&lt;br&gt;• Gaz ve ham petrol iletimi-depolaması — yalnızca birinci uygulama dönemi sonuna kadar (Geçici m. 6)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3ed;strokeColor=#cdd3c8;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=left;verticalAlign=top;fontSize=10;spacing=8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="48" y="1498" width="344" height="215" as="geometry"/></mxCell><mxCell id="31" value="&lt;b&gt;İDARİ PARA CEZALARI (m. 35)&lt;/b&gt;&lt;br&gt;Doğrulanmış raporu süresinde sunmayanlara, tesis kategorisine göre:&lt;br&gt;&amp;nbsp;&lt;br&gt;• Kategori A — ≤ 50.000 t · 627.450 ₺&lt;br&gt;• Kategori B — 50.001–250.000 t · 1.254.900 ₺&lt;br&gt;• Kategori B — 250.001–500.000 t · 2.509.800 ₺&lt;br&gt;• Kategori C — 500.001–2.000.000 t · 4.392.150 ₺&lt;br&gt;• Kategori C — &gt; 2.000.000 t · 6.274.500 ₺&lt;br&gt;&amp;nbsp;&lt;br&gt;ETS kapsamındaki işletmelere bu tutarlar İKİ KAT uygulanır.&lt;br&gt;İzinsiz faaliyet ayrı bir ceza kalemidir: 1.254.900 – 12.549.000 ₺." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6f5;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=left;verticalAlign=top;fontSize=10;spacing=8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="48" y="1792" width="344" height="400" as="geometry"/></mxCell><mxCell id="32" value="&lt;b&gt;DİKKAT&lt;/b&gt;&lt;br&gt;İzin 5 yıl geçerli. Bitiminden en az 6 ay önce yenileme başvurusu zorunlu (m. 8).&lt;br&gt;&amp;nbsp;&lt;br&gt;İzinsiz faaliyetin cezası 1.254.900 – 12.549.000 ₺ (m. 35)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6f5;strokeColor=#8f2b25;fontColor=#591a16;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=left;verticalAlign=top;fontSize=10;spacing=8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1605" y="1716" width="250" height="200" as="geometry"/></mxCell><mxCell id="33" value="&lt;b&gt;RENK ANAHTARI&lt;/b&gt;&lt;br&gt;YEŞİL — yükümlülük yok, sistem hiç uygulanmaz&lt;br&gt;SARI — yalnızca izleme, raporlama ve doğrulama&lt;br&gt;KIRMIZI — tam ETS: izin, İRD ve tahsisat teslimi&lt;br&gt;GRİ — yardımcı bilgi, akışın parçası değil" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a9b2a6;fontColor=#16232b;strokeWidth=2;fontFamily=Helvetica;verticalAlign=middle;align=left;verticalAlign=top;fontSize=10;spacing=8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1390" y="75" width="460" height="150" as="geometry"/></mxCell><mxCell id="34" value="&lt;b&gt;İşletmem ETS kapsamına giriyor mu?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Türkiye Emisyon Ticaret Sistemi · Tesis değerlendirmesi — Dayanak: RG 27.08.2026 / 33353&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontColor=#16232b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="60" width="1200" height="120" as="geometry"/></mxCell><mxCell id="35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6e7b76;strokeWidth=2;fontSize=11;fontColor=#5c6a66;endArrow=block;endFill=1;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="36" value="EVET" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6e7b76;strokeWidth=2;fontSize=11;fontColor=#5c6a66;endArrow=block;endFill=1;" edge="1" parent="1" source="